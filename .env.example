# 서버 전용 (Cloudflare: wrangler secret put 이름)
WEATHER_PROVIDER=open-meteo        # 개발 화면 확인용: mock
OPEN_METEO_API_KEY=                # 공개 후 유료 구독 키 (비우면 무료 API)
KAKAO_REST_API_KEY=                # 카카오 디벨로퍼스 REST API 키 (주소·장소 검색)

# 브라우저에 노출되는 값 (빌드 시점에 필요)
NEXT_PUBLIC_SITE_URL=https://tripnal.com
NEXT_PUBLIC_KAKAO_JS_KEY=          # 카카오 JavaScript 키 (지도), 도메인 등록 필요
NEXT_PUBLIC_ADSENSE_CLIENT=        # ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_AD_SLOT_SUMMARY=       # 요약 카드 아래 광고 단위 ID
NEXT_PUBLIC_AD_SLOT_DAYS=          # 일별 카드 사이 광고 단위 ID
NEXT_PUBLIC_AD_SLOT_SIDE=          # PC 사이드 광고 단위 ID
NEXT_PUBLIC_AD_SLOT_BOTTOM=        # 하단 광고 단위 ID
