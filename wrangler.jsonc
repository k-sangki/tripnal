{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "name": "tripnal",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tripnal"
    }
  ],
  // 배포 버전: 엣지 캐시 키에 넣어 배포 뒤 예전 페이지를 쓰지 않게 한다 (worker.ts)
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // 직접 수집한 예보 (collector/ → .github/workflows/collect.yml)
  "r2_buckets": [{ "binding": "DATA", "bucket_name": "tripnal-data" }],
  "routes": [
    { "pattern": "tripnalc.com", "custom_domain": true },
    { "pattern": "www.tripnalc.com", "custom_domain": true },
    { "pattern": "tripnal.com", "custom_domain": true },
    { "pattern": "www.tripnal.com", "custom_domain": true }
  ],
  "vars": {
    "WEATHER_PROVIDER": "collected",
    "NEXT_PUBLIC_SITE_URL": "https://tripnalc.com"
  }
}
